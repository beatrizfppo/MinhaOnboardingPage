<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MinhaOnboardingPage.Views.OnboardingPage"
             xmlns:viewmodels ="clr-namespace:MinhaOnboardingPage.ViewModels"
             xmlns:models ="clr-namespace:MinhaOnboardingPage.Models"
             x:DataType="viewmodels:OnboardingViewModel"
             BackgroundColor="#D0D0D0"
             Shell.NavBarIsVisible="False"
             Title="OnboardingPage">

    <Grid RowDefinitions="*, Auto, Auto" Padding="5,10">
        <CarouselView Grid.Row="0" Loop="False" 
                      ItemsSource="{Binding Itens}" 
                      IndicatorView="Indicador" 
                      Position="{Binding Posicao}"
                      >
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:OnboardingItem">
                    <VerticalStackLayout VerticalOptions="Center"
                                         Spacing="20">
                        
                        <Label Text="{Binding Titulo}"
                                 FontSize="28"
                                 HorizontalTextAlignment="Center"
                                 TextColor="#333"
                                 FontAttributes="Bold"
                               />
                        <Image Source="{Binding ImageUrl}"
                               Aspect="AspectFill"
                               HeightRequest="350"
                               />

                        <Label Text="{Binding Descricao}"
                               FontSize="18"
                               TextColor="#333"
                               HorizontalTextAlignment="Center"
                               />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="Indicador"
                       Grid.Row="1"
                       HorizontalOptions="Center"
                       IndicatorColor="White"
                       SelectedIndicatorColor="#80c46b"
                       IndicatorSize="14"
                       />

        <Grid ColumnDefinitions="*,*" Grid.Row="2" ColumnSpacing="15">
            <Button Grid.Column="0" 
                    Text="Começar" 
                    BackgroundColor="#80C46B"/>

            <Button Grid.Column="1" 
                    Text="Avançar" 
                    Command="{Binding ProximoCommand}" 
                    BackgroundColor="#F0A46B" 
                    IsVisible="{Binding ExibirBotao}"/> 
        </Grid>

    </Grid>
    
</ContentPage>